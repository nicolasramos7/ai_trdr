# Copy this file to .env and fill in your credentials.

# Model — Google Gemini 2.5 Flash by default.
MODEL=gemini-2.5-flash
PROFILE_NAME=gemini

# Optional: override the Gemini OpenAI-compatible endpoint (leave as default).
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Google Gemini API key
# Get one from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Alpaca PAPER Trading API
# Get keys from: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your-paper-trading-key-id
ALPACA_SECRET_KEY=your-paper-trading-secret-key
# Paper endpoint only. A trailing /v2 is stripped automatically.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Finnhub API for the get_stock_news tool (real-time financial news + sentiment).
# Get your free Finnhub API key at https://finnhub.io — no credit card required.
FINNHUB_API_KEY=your-finnhub-api-key

# ---------------------------------------------------------------------------
# Risk engine (all optional — sensible defaults apply when unset).
# These are enforced in code, not by the model. Any invalid or non-positive
# value falls back to its default rather than disabling the limit.
# ---------------------------------------------------------------------------

# Close a position automatically once it is down this many percent.
# RISK_STOP_LOSS_PCT=7

# Close a position automatically once it is up this many percent.
# RISK_TAKE_PROFIT_PCT=15

# Maximum share of total equity allowed in any single position.
# RISK_MAX_POSITION_PCT=25

# Share of equity always held back as cash and never deployed.
# RISK_CASH_RESERVE_PCT=10

# Block all new buys once equity falls this far below its peak.
# Selling always remains allowed.
# RISK_MAX_DRAWDOWN_PCT=15

# Maximum buy orders per session, to limit spread costs from churn.
# RISK_MAX_BUYS_PER_SESSION=4
