# Copy this file to .env and fill in your credentials.

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
# Google retires Gemini model ids on a schedule and silently reroutes some of
# them (gemini-2.5-flash is rerouted to gemini-3.5-flash-lite from 2026-12-01).
# The agent now LISTS available models at startup and refuses to run if the
# configured one is missing, rather than trading on a substitute. Check
# https://aistudio.google.com for current ids.
MODEL=gemini-2.5-flash
FALLBACK_MODEL=gemini-2.5-flash-lite
PROFILE_NAME=gemini

# Optional: override the Gemini OpenAI-compatible endpoint (leave as default).
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Google Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Model requests allowed per session, INCLUDING retries.
#
# Google no longer publishes free-tier limits per model; the only authoritative
# figures are in your own dashboard at https://aistudio.google.com/rate-limit.
# Community reports for 2.5 Flash range from 250 requests/day down to 20, so the
# default is sized against the pessimistic end: 3 per session x 3 scheduled
# slots = 9/day worst case. Quotas apply per PROJECT, not per key.
# MAX_MODEL_REQUESTS=3

# Minimum milliseconds between model requests, to stay under the per-minute cap.
# MIN_REQUEST_INTERVAL_MS=12500

# Gemini thinking budget for the tool-calling loop: none | low | medium | high.
# GEMINI_REASONING_EFFORT=low

# ---------------------------------------------------------------------------
# Alpaca PAPER trading — https://app.alpaca.markets/paper/dashboard/overview
# ---------------------------------------------------------------------------
ALPACA_API_KEY=your-paper-trading-key-id
ALPACA_SECRET_KEY=your-paper-trading-secret-key
# Paper endpoint only; the agent refuses to start against live trading.
# A trailing /v2 is stripped automatically.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Market-data feed for bars: iex (free on paper accounts) or sip (subscription).
# ALPACA_DATA_FEED=iex

# ---------------------------------------------------------------------------
# News
# ---------------------------------------------------------------------------
# Finnhub for the get_stock_news tool. Free key, no credit card, 60 calls/min.
FINNHUB_API_KEY=your-finnhub-api-key

# ---------------------------------------------------------------------------
# Safe testing
# ---------------------------------------------------------------------------
# Runs a full session — risk engine, model, decisions — but submits NO orders,
# and is the only way to run outside market hours. This replaces the old
# TESTING_MODE flag, which worked by disabling the market-hours check itself and
# so allowed real orders at 22:00 on a Sunday.
# DRY_RUN=true

# ---------------------------------------------------------------------------
# Risk engine (all optional — the defaults below ARE the shipped values).
#
# Enforced in code, not by the model. Any invalid or non-positive value falls
# back to its default rather than disabling the limit. These same names are read
# by the Cloudflare Worker, so one set of values configures both halves.
# ---------------------------------------------------------------------------

# --- position sizing ---
# Percent of equity risked per trade, assuming the stop fills at its trigger.
# Size is derived from this: notional = equity * riskPerTrade / stopDistance.
# A name needing a wide stop therefore gets a SMALL position. This is the main
# risk dial — raise it for more return and more drawdown, in roughly equal
# measure.
# RISK_PER_TRADE_PCT=2.5

# Hard ceiling on any single position, as a percent of equity.
# RISK_MAX_POSITION_PCT=30

# Share of equity always held back as cash and never deployed.
# RISK_CASH_RESERVE_PCT=5

# --- stops ---
# Hard stop placed this many ATRs below entry, clamped into the band below.
# RISK_ATR_STOP_MULTIPLE=2.5
# RISK_MIN_STOP_PCT=5
# RISK_MAX_STOP_PCT=12

# Fallback stop used only when bar data is unavailable and no ATR can be
# measured.
# RISK_STOP_LOSS_PCT=8

# --- trailing stop ---
# Trailing arms once the high since entry is this far above entry, then follows
# at this many ATRs below the high, clamped into the band.
# RISK_TRAIL_ACTIVATE_PCT=6
# RISK_TRAIL_ATR_MULTIPLE=1.5
# RISK_MIN_TRAIL_PCT=3
# RISK_MAX_TRAIL_PCT=10

# Far-away take-profit, a backstop for positions with no bar data.
# RISK_TAKE_PROFIT_PCT=30

# --- book shape ---
# Maximum simultaneous positions; the regime filter may lower this.
# RISK_MAX_POSITIONS=3

# Minimum size for OPENING a new position. Smaller stakes cannot cover their own
# round trip once the $0.01 fee floor and spread are counted. Adding to an
# existing position is exempt. Never exceeds what the concentration cap allows.
# RISK_MIN_POSITION_NOTIONAL=15

# Hours a position must be held before a DISCRETIONARY sell is allowed.
# Risk-engine exits always bypass this.
# RISK_MIN_HOLD_HOURS=24

# Hours before a sold ticker may be re-bought.
# RISK_MIN_REBUY_HOURS=24

# Maximum buy orders per session.
# RISK_MAX_BUYS_PER_SESSION=2

# Minimum share price. Sub-$10 names carry spreads that consume any edge.
# RISK_MIN_SHARE_PRICE=10

# Minimum dollar value of a partial sell.
# RISK_MIN_SELL_NOTIONAL=5

# Maximum quoted bid/ask spread, as a percent of mid, for a BUY.
# RISK_MAX_SPREAD_PCT=0.5

# --- drawdown ---
# Position sizing halves once equity falls this far below its peak. Buying is
# never blocked outright: recovery requires being invested.
# RISK_MAX_DRAWDOWN_PCT=20
# RISK_PEAK_LOOKBACK_DAYS=30

# --- market regime ---
# Benchmark trend filter. Below the slow MA halves risk and caps the book at one
# position; above both MAs allows the full budget.
# RISK_REGIME_FAST_DAYS=20
# RISK_REGIME_SLOW_DAYS=100
# REGIME_BENCHMARK=SPY

# --- session timing ---
# Minutes after the open and before the close in which a session will not open a
# new position (spreads are widest there). Exits are unaffected — they run in
# the Worker every two minutes regardless.
# OPEN_BUFFER_MINUTES=10
# CLOSE_BUFFER_MINUTES=15
